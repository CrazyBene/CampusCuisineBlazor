@page "/recipes/{Id:guid}"
@inject RecipeService RecipeService

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (loading)
{
    <p>Loading recipe...</p>
}
else if (recipe is null)
{
    <PageTitle>Recipe not found</PageTitle>

    <h1>Recipe not found</h1>

    <p>There is no recipe with this id.</p>
}
else
{
    <PageTitle>@recipe.Name</PageTitle>

    <span class="category">@recipe.Category</span>
    <h1>@recipe.Name</h1>

    <h2>Ingredients</h2>
    <ul>
        @foreach (var ingredient in recipe.Ingredients.Split(", "))
        {
            <li>@ingredient</li>
        }
    </ul>

    <h2>Instructions</h2>
    <p>@recipe.Instructions</p>

    <h2>Your rating</h2>
    <StarRating @bind-Value="rating" @bind-Value:after="SaveRating" />
    <p class="text-muted">
        @(rating == 0 ? "Not rated yet." : $"You rated this recipe {rating} of 5.")
    </p>
}

<a href="recipes">Back to all recipes</a>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool loading = true;
    private string? error;
    private Recipe? recipe;
    private int rating;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;

        try
        {
            recipe = await RecipeService.GetRecipeAsync(Id);
            rating = await RecipeService.GetRatingAsync(Id);
        }
        catch (HttpRequestException)
        {
            error = "Could not load the recipe. Is the backend running?";
        }

        loading = false;
    }

    private async Task SaveRating()
    {
        await RecipeService.RateAsync(Id, rating);
    }
}
