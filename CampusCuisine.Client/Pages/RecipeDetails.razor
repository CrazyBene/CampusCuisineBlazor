@page "/recipes/{Id:guid}"
@inject RecipeService RecipeService
@inject IJSRuntime JS

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (loading)
{
    <p>@L["Loading recipe..."]</p>
}
else if (recipe is null)
{
    <PageTitle>@L["Recipe not found"]</PageTitle>

    <h1>@L["Recipe not found"]</h1>

    <p>@L["There is no recipe with this id."]</p>
}
else
{
    <PageTitle>@recipe.Name</PageTitle>

    <span class="category">@recipe.Category</span>
    <h1>@recipe.Name</h1>

    <FavoriteButton RecipeId="recipe.Id" />

    <h2>
        @L["Ingredients"]
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyIngredientsAsync">
            @copyText
        </button>
    </h2>
    <ul>
        @foreach (var ingredient in recipe.Ingredients.Split(", "))
        {
            <li>@ingredient</li>
        }
    </ul>

    <h2>@L["Instructions"]</h2>
    <p>@recipe.Instructions</p>

    <h2>@L["Your rating"]</h2>
    <StarRating @bind-Value="rating" @bind-Value:after="SaveRating" />
    <p class="text-muted">
        @(rating == 0 ? L["Not rated yet."] : L["You rated this recipe {0} of 5.", rating])
    </p>
}

<a href="recipes">@L["Back to all recipes"]</a>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool loading = true;
    private string? error;
    private Recipe? recipe;
    private int rating;
    private string copyText = "";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        copyText = L["Copy"];

        try
        {
            recipe = await RecipeService.GetRecipeAsync(Id);
            rating = await RecipeService.GetRatingAsync(Id);
        }
        catch (HttpRequestException)
        {
            error = L["Could not load the recipe. Is the backend running?"];
        }

        loading = false;
    }

    private async Task CopyIngredientsAsync()
    {
        var ingredients = string.Join(Environment.NewLine, recipe!.Ingredients.Split(", "));

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ingredients);
            copyText = L["Copied!"];
        }
        catch (JSException)
        {
            copyText = L["Copy failed"];
        }
    }

    private async Task SaveRating()
    {
        await RecipeService.RateAsync(Id, rating);
    }
}
