@page "/recipes/{Id:int}"

@if (recipe is null)
{
    <PageTitle>Recipe not found</PageTitle>

    <h1>Recipe not found</h1>

    <p>There is no recipe with the id @Id.</p>
}
else
{
    <PageTitle>@recipe.Name</PageTitle>

    <span class="category">@recipe.Category</span>
    <h1>@recipe.Name</h1>

    <h2>Ingredients</h2>
    <ul>
        @foreach (var ingredient in recipe.Ingredients.Split(", "))
        {
            <li>@ingredient</li>
        }
    </ul>

    <h2>Instructions</h2>
    <p>@recipe.Instructions</p>

    <h2>Your rating</h2>
    <StarRating @bind-Value="rating" />
    <p class="text-muted">
        @(rating == 0 ? "Not rated yet." : $"You rated this recipe {rating} of 5.")
    </p>
}

<a href="recipes">Back to all recipes</a>

@code {
    [Parameter]
    public int Id { get; set; }

    private Recipe? recipe;
    private int rating;

    protected override void OnParametersSet()
    {
        recipe = SampleRecipes.All.FirstOrDefault(r => r.Id == Id);
        rating = 0;
    }
}
